# Site público
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity: projeto CMS e dataset PRIVADO para permitir armazenamento seguro de mensagens
# Atenção: IDs públicos não são segredos. Tokens abaixo NUNCA devem usar prefixo NEXT_PUBLIC_!
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-03-01
SANITY_READ_TOKEN=
SANITY_SEED_WRITE_TOKEN=

# CAIXA DE MENSAGENS (opcional): habilitar SOMENTE após confirmar que o dataset é PRIVADO
SANITY_PRIVATE_DATASET=false
SANITY_INBOX_WRITE_TOKEN=

# Google Analytics 4 (opcional). ID da métrica, formato G-XXXXXXXXXX. Só carrega após o consentimento do visitante.
NEXT_PUBLIC_GA_ID=

# Página pública de horários do Google Calendar (opcional). Também pode ser alterada no /admin.
NEXT_PUBLIC_GOOGLE_BOOKING_URL=

# Envio de formulário por e-mail (opcional). O remetente deve pertencer a domínio validado.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
